{
  "name": "cs-course-atlas",
  "version": "1.0.0",
  "private": true,
  "description": "CS Course Atlas with Neon SQL backend",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:migrate": "node server/migrate.js",
    "db:doctor": "node scripts/neon-doctor.js",
    "check:frontend": "node --check js/atlas.js && node --check js/script.js && node --check js/course-curriculum.js && node --check js/course-examples.js && node scripts/build-atlas-data.js --check",
    "test:smoke": "playwright test",
    "test:smoke:headed": "playwright test --headed",
    "build:css": "tailwindcss -c tailwind.config.cjs -i ./css/tailwind.input.css -o ./css/tailwind.css --minify",
    "dev:css": "tailwindcss -c tailwind.config.cjs -i ./css/tailwind.input.css -o ./css/tailwind.css --watch",
    "build:seo": "node scripts/build-seo-pages.js",
    "build:site": "npm run build:data && npm run build:css && npm run build:seo",
    "check:curriculum": "node scripts/verify_course_curriculum.js",
    "check:examples": "node scripts/verify_course_examples.js",
    "test:examples": "node scripts/run_course_examples.js",
    "build:data": "node scripts/build-atlas-data.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "tailwindcss": "^3.4.17"
  }
}
