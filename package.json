{
  "name": "cs-course-atlas",
  "version": "1.0.0",
  "private": true,
  "description": "CS Course Atlas with Neon SQL backend",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:migrate": "node server/migrate.js",
    "db:doctor": "node scripts/neon-doctor.js",
    "check:frontend": "node --check js/script.js",
    "test:smoke": "playwright test",
    "test:smoke:headed": "playwright test --headed",
    "build:css": "tailwindcss -c tailwind.config.cjs -i ./css/tailwind.input.css -o ./css/tailwind.css --minify",
    "dev:css": "tailwindcss -c tailwind.config.cjs -i ./css/tailwind.input.css -o ./css/tailwind.css --watch",
    "build:seo": "node scripts/build-seo-pages.js",
    "build:site": "npm run build:css && npm run build:seo",
    "test:unit": "node --test tests/unit/*.test.js",
    "check:content": "node scripts/verify_catalog_integrity.js && node scripts/verify_localization.js && node scripts/verify_css_integrity.js && node scripts/verify_module_examples.js && node scripts/verify_module_outputs.js && node scripts/verify_spanish_code_examples.js",
    "check": "npm run check:frontend && npm run check:content && npm run test:unit",
    "preview": "node scripts/serve-static.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "qs": "^6.17.1"
  }
}
